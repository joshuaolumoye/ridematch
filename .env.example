# Copy this file to .env and fill in real values before running the app.
# See README.md for setup instructions.

APP_ENV=development
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ridematch
DB_PASSWORD=change_me
DB_NAME=ridematch

# ---- Redis (live driver location, rate limiting) ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ---- OTP ----
OTP_TTL=5m
OTP_LENGTH=6
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5

# ---- Driver subscription (kobo = NGN * 100) ----
DRIVER_SUB_DAILY_FEE_KOBO=100000
DRIVER_GRACE_PERIOD=6h

# ---- Live location / nearby matching ----
# How long a driver's last location ping is trusted before they're treated
# as offline/stale and filtered out of nearby-driver results.
LOCATION_STALE_AFTER=45s
NEARBY_DEFAULT_RADIUS_KM=5
NEARBY_MAX_RADIUS_KM=20
NEARBY_DEFAULT_LIMIT=20
# Decimal places driver coordinates are rounded to before being returned
# in a nearby list (3 ≈ 111m) — avoids exposing a driver's exact live
# position to every passenger browsing the map, per the NDPR-minded
# design discussed earlier; exact location is only needed once a match
# is confirmed.
NEARBY_COORDINATE_PRECISION=3

# ---- Trips (matching, negotiation, rate limits) ----
# A requested trip with no accepted offer after this long is lazily
# marked "expired" the next time it's touched (read, offered on, etc.) —
# no background sweeper needed.
TRIP_EXPIRY_AFTER=10m
# Per-user, per-minute caps on the two trip write paths, enforced by the
# Redis-backed rate limiter (fixed window, fails open on Redis errors).
RATE_LIMIT_TRIP_CREATE_PER_MINUTE=5
RATE_LIMIT_OFFER_CREATE_PER_MINUTE=20

# ---- SMS ----
# SMS_PROVIDER=console logs OTP codes to the server console instead of
# sending real SMS — use this for local development. Set to "termii" and
# fill in TERMII_API_KEY for production.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=RideMatch

# ---- Flutterwave (driver daily-access subscription payment) ----
# Get these from your Flutterwave dashboard (Settings -> API). Use the
# FLWSECK_TEST-... / FLWPUBK_TEST-... keys while testing — Flutterwave
# switches between test and live mode based on which key pair you use,
# not on a different URL.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# Set this to the same string you configure as the webhook "secret hash"
# in the Flutterwave dashboard (Settings -> Webhooks) — it's how
# POST /webhooks/flutterwave verifies a request actually came from
# Flutterwave (sent back verbatim in the verif-hash header).
FLW_WEBHOOK_SECRET_HASH=
# Where Flutterwave redirects the driver's browser/app after payment,
# when the checkout request doesn't specify its own redirect_url. Point
# this at your mobile app's deep link once it exists
# (e.g. ridematch://payment-callback).
FLW_REDIRECT_URL=https://ridematch.app/payment-callback
# Leave empty in normal operation. Only used to point the client at a
# local stub server for testing — see scripts/payment_flow_test.py.
FLW_BASE_URL=

# ---- Object storage (driver ID docs / vehicle photos) ----
# "local" (default) writes to ./uploads on this server's own disk — fine
# for development, but it means uploads vanish on redeploy and don't
# survive running more than one API instance. "s3" talks to any
# S3-compatible object store; this app is set up for IDrive e2 (cheap, no
# egress fees), but the same client works unmodified against R2, Backblaze
# B2, MinIO, or real AWS S3 — just point S3_ENDPOINT elsewhere.
#
# To switch to IDrive e2:
#   1. In the e2 dashboard, create a bucket and set it to allow public
#      read (or put a CDN/custom domain in front of it) — S3_PUBLIC_BASE_URL
#      below has to actually be reachable by end users' phones.
#   2. Create an access key pair (e2 dashboard -> "Access Keys").
#   3. Copy the bucket's endpoint shown on its detail page — it looks like
#      https://xxxxx.xxx.idrivee2-xx.com (per-account, not a fixed host).
#   4. Fill in the S3_* values below and set STORAGE_DRIVER=s3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# <S3_ENDPOINT>/<S3_BUCKET> if left blank (correct for a public bucket
# with no CDN in front of it) — set explicitly if you put a custom domain
# in front of the bucket instead.
S3_PUBLIC_BASE_URL=
# IDrive e2 needs path-style addressing (endpoint/bucket/key). Leave this
# on unless you're pointing STORAGE_DRIVER=s3 at real AWS S3.
S3_FORCE_PATH_STYLE=true
